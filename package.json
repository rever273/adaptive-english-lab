{
  "name": "english-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "English Lab - personal local-only adaptive English practice (TASK_003 foundation)",
  "engines": {
    "node": ">=22.17.0 <23"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @english-lab/contracts && npm run build -w @english-lab/learning && npm run build -w @english-lab/server && npm run build -w @english-lab/web",
    "typecheck": "npm run build -w @english-lab/contracts && npm run build -w @english-lab/learning && tsc -p apps/server --noEmit && tsc -p apps/web --noEmit",
    "test:unit": "node scripts/vitest.mjs --config vitest.unit.config.ts",
    "test:integration": "node scripts/vitest.mjs",
    "watch:web": "npm run build -w @english-lab/web -- --watch",
    "start": "node scripts/start.mjs",
    "lab": "node scripts/start.mjs --attached",
    "dev": "npm run stop -- --force && npm run build && npm run lab",
    "stop": "node scripts/stop.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "lab:export": "node scripts/lab-export.mjs",
    "lab:verdicts": "node scripts/attempt-verdicts.mjs",
    "lab:thoughts": "node scripts/lab-thoughts.mjs",
    "vocab:backfill": "node scripts/vocab-backfill.mjs",
    "typing:seed": "node scripts/typing-seed.mjs",
    "dictation:setup": "node scripts/dictation-setup.mjs",
    "voices:evaluate": "node scripts/voices-evaluate.mjs",
    "typing:prepare-book": "node scripts/typing-prepare-book.mjs",
    "typing:build-wordlist": "node scripts/typing-build-wordlist.mjs",
    "content:agent": "node scripts/content-agent.mjs",
    "content:loop": "node scripts/context-loop-agent.mjs",
    "content:validate": "node scripts/content-validate.mjs",
    "trial:generate": "node scripts/generation-trial.mjs",
    "verify:stt": "node scripts/verify-stt.mjs",
    "test:python": "py -3.11 -m unittest discover -s tests/python -v",
    "gen:taxonomy-seed": "node scripts/gen-taxonomy-seed.mjs",
    "slice:seed": "node scripts/seed-slice.mjs",
    "first10:check": "node scripts/first10-check.mjs",
    "first10:seed": "node scripts/first10-seed.mjs",
    "lessons:trial": "node scripts/word-lesson-trial.mjs",
    "pack": "node scripts/content-pack.mjs",
    "slice": "node scripts/slice.mjs",
    "verify:gpu": "node scripts/verify-gpu.mjs",
    "verify:windows": "node scripts/verify-windows.mjs",
    "verify:backup-restore": "node scripts/verify-windows.mjs --backup-restore",
    "benchmark:ai": "node scripts/benchmark-ai.mjs",
    "slice:stop": "node scripts/slice-stop.mjs",
    "test:e2e": "node scripts/vitest.mjs --config vitest.e2e.config.ts",
    "skills:labels": "node scripts/skill-labels-sync.mjs",
    "cloze:prepare": "node scripts/grammar-cloze-prepare.mjs",
    "cloze:import": "node scripts/grammar-cloze-import.mjs",
    "vtyping:prepare": "node scripts/vtyping-prepare.mjs",
    "vtyping:clean": "node scripts/vtyping-clean.mjs",
    "vtyping:import-tatoeba": "node scripts/vtyping-import-tatoeba.mjs",
    "vtyping:import-lexicon-examples": "node scripts/vtyping-import-lexicon-examples.mjs"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
